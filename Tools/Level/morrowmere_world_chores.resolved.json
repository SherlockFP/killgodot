  {
   "id": "WaterRun",
   "title": "Water run",
   "blurb": "Fill a bucket at the well and carry it without running.",
   "replaces": [
    "DrawWater"
   ],
   "bots": true,
   "variants": [
    {
     "name": "fountain",
     "vars": {
      "src": "fountain_trough",
      "dst": "fountain_trough"
     }
    },
    {
     "name": "bakery",
     "vars": {
      "src": "bakery_butt",
      "dst": "bakery_butt"
     }
    },
    {
     "name": "farm",
     "vars": {
      "src": "well",
      "dst": "farm_trough"
     }
    }
   ],
   "steps": [
    {
     "verb": "take",
     "at": "$src",
     "item": "Bucket",
     "secs": 0.8,
     "label": "Take the empty bucket at $src",
     "cue": "Thud"
    },
    {
     "verb": "bring",
     "at": "well",
     "item": "Bucket",
     "secs": 4.5,
     "fill": 1.0,
     "label": "Crank the bucket full at the well",
     "cue": "Crank"
    },
    {
     "verb": "bring",
     "at": "$dst",
     "item": "Bucket",
     "secs": 2.0,
     "min_fill": 0.35,
     "effect": "water",
     "label": "Carry the water to $dst - walk, don't run!",
     "cue": "Pour"
    }
   ]
  },
  {
